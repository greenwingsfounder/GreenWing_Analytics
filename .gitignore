# ═══════════════════════════════════════════════════════════
# GreenWing Analytics — .gitignore
# ═══════════════════════════════════════════════════════════
# KURAL: Bu dosyaya GÜVENLİK istisnaları eklerken çok dikkatli ol.
# Hiçbir gizli anahtar, kimlik bilgisi veya müşteri verisi
# depoya commit EDİLMEZ.

# ─── GİZLİ ANAHTARLAR / KİMLİK BİLGİLERİ (ASLA COMMIT ETME) ──
.env
.env.*
!.env.example
credentials.json
credentials*.json
*client_secret*
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.yaml
secrets.yml
.npmrc
.netrc
.git-credentials

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Sanal ortamlar ─────────────────────────────────────────
greenWing_env/
venv/
.venv/
env/
ENV/

# ─── Test / araç çıktıları ──────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.bandit
bandit-report.*

# ─── Jupyter ────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── OS / editör ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.log

# ─── Çalışma zamanı verisi / üretilen raporlar ───────────────
# Müşteri yakıt verisi ve üretilen raporlar depoya girmez.
data/raw/
data/processed/
data/calibrations/
data/customer_fuel/
data/mocks/
data/archive/opensky_real/
reports/case_studies/
reports/optimizations/*.html
reports/optimizations/*.csv
*.xlsx
*.pdf
# Teslimat: teknik doğrulama raporu sürüm kontrolünde tutulur
!reports/GreenWing_Teknik_Rapor.pdf
