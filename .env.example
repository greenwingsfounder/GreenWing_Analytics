# ═══════════════════════════════════════════════════════════
# GreenWing Analytics — Ortam Değişkenleri ŞABLONU
# ═══════════════════════════════════════════════════════════
#
# KULLANIM:
#   1) Bu dosyayı kopyala →  cp .env.example .env
#   2) .env içindeki boş değerleri kendi kimlik bilgilerinle doldur
#   3) .env dosyası .gitignore içinde — ASLA commit edilmez
#
# ⚠️  GERÇEK DEĞERLERİ BU DOSYAYA YAZMA. Bu dosya herkese açık
#     şablondur; sadece boş/örnek değerler içerir.

# ─── OpenSky Network API (opsiyonel) ────────────────────────
# OAuth2 (tercih edilen):
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Basic auth (alternatif):
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ─── Dashboard ──────────────────────────────────────────────
# Üretimde 127.0.0.1 bırak ve ters proxy arkasına al.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
# Üretimde MUTLAKA false yap (debug=True uzak kod çalıştırma riski).
DASHBOARD_DEBUG=false
